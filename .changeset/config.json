{
	"$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
	"changelog": [
		"@changesets/changelog-github",
		{
			"repo": "astra-void/loom"
		}
	],
	"commit": false,
	"access": "public",
	"baseBranch": "main",
	"updateInternalDependencies": "patch",
	"linked": [],
	"//": "Listed one by one rather than as an `@loom-dev/*` glob: that glob also matches the private apps/*, which changesets rejects mixing into a fixed group.",
	"fixed": [
		[
			"loom-dev",
			"@loom-dev/scene",
			"@loom-dev/layout",
			"@loom-dev/runtime",
			"@loom-dev/renderer",
			"@loom-dev/react",
			"@loom-dev/preview",
			"@loom-dev/vide",
			"@loom-dev/luau"
		]
	],
	"ignore": [
		"@loom-dev/example",
		"@loom-dev/gallery-demo",
		"@loom-dev/interactive",
		"@loom-dev/luau-example",
		"@loom-dev/playground",
		"@loom-dev/vide-example"
	]
}
