{
	"name": "@loom-dev/preview",
	"version": "0.12.0",
	"description": "Loom source-first preview: run a roblox-ts UI source tree in the browser, via a Vite plugin.",
	"keywords": [
		"loom",
		"roblox",
		"roblox-ts",
		"preview",
		"vite",
		"vite-plugin"
	],
	"license": "MIT",
	"author": "astra-void",
	"homepage": "https://github.com/astra-void/loom#readme",
	"bugs": "https://github.com/astra-void/loom/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astra-void/loom.git",
		"directory": "packages/preview"
	},
	"type": "module",
	"sideEffects": [
		"./dist/globals.js",
		"./src/globals.ts"
	],
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"exports": {
		".": "./src/index.ts",
		"./vite": "./src/vite.ts",
		"./client": "./src/client.ts",
		"./globals": "./src/globals.ts",
		"./services": "./src/services.ts",
		"./gallery": "./src/gallery.ts"
	},
	"types": "./src/index.ts",
	"publishConfig": {
		"access": "public",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./client": {
				"types": "./dist/client.d.ts",
				"default": "./dist/client.js"
			},
			"./globals": {
				"types": "./dist/globals.d.ts",
				"default": "./dist/globals.js"
			},
			"./services": {
				"types": "./dist/services.d.ts",
				"default": "./dist/services.js"
			},
			"./gallery": {
				"types": "./dist/gallery.d.ts",
				"default": "./dist/gallery.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@loom-dev/react": "workspace:*",
		"@loom-dev/renderer": "workspace:*",
		"@loom-dev/runtime": "workspace:*",
		"happy-dom": "^20.10.6"
	},
	"peerDependencies": {
		"react": "^18.3.1",
		"vite": "^6.0.0 || ^7.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@rbxts/react": "17.3.7-ts.2",
		"@rbxts/react-roblox": "17.3.7-ts.2",
		"@types/node": "^22.0.0",
		"@types/react": "catalog:",
		"react": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
