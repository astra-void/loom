{
	"name": "loom-dev",
	"version": "0.12.0",
	"description": "CLI for the loom preview and build toolchain — preview a roblox-ts UI project in the browser with zero config.",
	"keywords": [
		"loom",
		"roblox",
		"roblox-ts",
		"cli",
		"preview",
		"gallery",
		"nextjs"
	],
	"license": "MIT",
	"author": "astra-void",
	"homepage": "https://github.com/astra-void/loom#readme",
	"bugs": "https://github.com/astra-void/loom/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astra-void/loom.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"bin": {
		"loom": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"exports": {
		"./embed": "./src/embed.ts",
		"./next": "./src/next.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			"./embed": {
				"types": "./dist/embed.d.ts",
				"default": "./dist/embed.js"
			},
			"./next": {
				"types": "./dist/next.d.ts",
				"default": "./dist/next.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsx src/cli.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@loom-dev/preview": "workspace:*",
		"react": "catalog:",
		"vite": "catalog:"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/react": "catalog:",
		"tsdown": "catalog:",
		"tsx": "^4.19.0",
		"typescript": "catalog:"
	}
}
