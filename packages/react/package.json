{
	"name": "@loom-dev/react",
	"version": "0.12.0",
	"description": "React renderer for loom — a react-reconciler host config driving loom's live Roblox instance tree.",
	"keywords": [
		"loom",
		"roblox",
		"roblox-ts",
		"react",
		"react-reconciler",
		"renderer"
	],
	"license": "MIT",
	"author": "astra-void",
	"homepage": "https://github.com/astra-void/loom#readme",
	"bugs": "https://github.com/astra-void/loom/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astra-void/loom.git",
		"directory": "packages/react"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"types": "./src/index.ts",
	"publishConfig": {
		"access": "public",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@loom-dev/layout": "workspace:*",
		"@loom-dev/renderer": "workspace:*",
		"@loom-dev/runtime": "workspace:*",
		"@loom-dev/scene": "workspace:*",
		"react-reconciler": "catalog:"
	},
	"peerDependencies": {
		"react": "^18.3.1"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"react": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
