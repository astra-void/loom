{
	"name": "@loom-dev/luau",
	"version": "0.14.1",
	"description": "Luau adapter for loom — upstream Luau compiled to WASM, running Luau UI scripts against the loom runtime.",
	"keywords": [
		"loom",
		"roblox",
		"luau",
		"wasm",
		"ui"
	],
	"license": "MIT",
	"author": "astra-void",
	"homepage": "https://github.com/astra-void/loom#readme",
	"bugs": "https://github.com/astra-void/loom/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astra-void/loom.git",
		"directory": "packages/luau"
	},
	"type": "module",
	"sideEffects": [
		"./src/entry.ts",
		"./dist/entry.js"
	],
	"files": [
		"dist",
		"wasm"
	],
	"exports": {
		".": "./src/index.ts",
		"./entry": "./src/entry.ts"
	},
	"types": "./src/index.ts",
	"publishConfig": {
		"access": "public",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./entry": {
				"types": "./dist/entry.d.ts",
				"default": "./dist/entry.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"build:vm": "bash native/build.sh",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@loom-dev/layout": "workspace:*",
		"@loom-dev/react": "workspace:*",
		"@loom-dev/runtime": "workspace:*"
	},
	"peerDependencies": {
		"react": "^18.3.1"
	},
	"devDependencies": {
		"@loom-dev/scene": "workspace:*",
		"@types/node": "^22.0.0",
		"@types/react": "catalog:",
		"react": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}
