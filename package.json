{
	"name": "loom",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.6.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build:native": "bash scripts/build-wasm.sh",
		"build:native:release": "LOOM_WASM_PROFILE=release bash scripts/build-wasm.sh",
		"prepare": "pnpm build:native",
		"build": "pnpm -r run build",
		"build:packages": "pnpm -r --filter \"./packages/*\" run build",
		"typecheck": "pnpm -r run typecheck",
		"test": "cargo test && vitest run --passWithNoTests",
		"test:packed": "node scripts/packed-next-test.mjs",
		"test:base-path": "node scripts/next-base-path-test.mjs",
		"lint": "biome check .",
		"format": "biome format --write .",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"publish:packages": "pnpm -r --filter \"./packages/*\" publish --no-git-checks",
		"release": "pnpm build:native:release && pnpm build:packages && pnpm publish:packages",
		"test:packed-dev": "node scripts/packed-dev-test.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"happy-dom": "^21.0.4",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
